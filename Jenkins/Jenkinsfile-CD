@Library('shared') _
pipeline {
    agent any
    
    stages {
        stage("Workspace cleanup"){
            steps{
                script{
                    cleanWs()
                }
            }
        }
        
        stage('Git: Code Checkout') {
            steps {
                script{
                    code_checkout("https://github.com/kumarprakash21/Wanderlust-Mega-Project.git","main")
                }
            }
        }
        
        stage('Generate: Docker Image Tag') {
            steps {
                script{
                    env.IMAGE_TAG = sh(
                        script: 'git rev-parse --short=12 HEAD',
                        returnStdout: true
                    ).trim()
                    echo "Using generated image tag: ${env.IMAGE_TAG}"
                }
            }
        }
        
        
        stage("Update: Kubernetes Manifests"){
            steps{
                script{
                    dir('kubernetes'){
                        sh "sed -i -E 's#(wanderlust-backend:)[^[:space:]]+#\\1${env.IMAGE_TAG}#' backend.yaml"
                    }
                    
                    dir('kubernetes'){
                        sh "sed -i -E 's#(wanderlust-frontend:)[^[:space:]]+#\\1${env.IMAGE_TAG}#' frontend.yaml"
                    }
                    
                }
            }
        }
        
        stage("Git: Code update and push to GitHub"){
            steps{
                script{
                    withCredentials([gitUsernamePassword(credentialsId: 'Github', gitToolName: 'Default')]) {
                        sh '''
                        echo "Checking repository status: "
                        git status
                    
                        echo "Adding changes to git: "
                        git add .
                        
                        echo "Commiting changes: "
                        git commit -m "Updated environment variables"
                        
                        echo "Pushing changes to github: "
                        git push origin main
                    '''
                    }
                }
            }
        }
    }
  post {
        success {
            script {
                emailext attachLog: false,
                from: 'prakashgautam2312@gmail.com',
                subject: "✅ Deployment completed: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: """
                    <div style="font-family:Arial,sans-serif;max-width:640px;color:#243047">
                      <h2 style="color:#16803c">Deployment completed successfully</h2>
                      <p>Kubernetes manifests were updated and pushed to the main branch.</p>
                      <table cellpadding="7" style="border-collapse:collapse">
                        <tr><td><b>Project</b></td><td>${env.JOB_NAME}</td></tr>
                        <tr><td><b>Build</b></td><td>#${env.BUILD_NUMBER}</td></tr>
                        <tr><td><b>Image tag</b></td><td><code>${env.IMAGE_TAG}</code></td></tr>
                        <tr><td><b>Duration</b></td><td>${currentBuild.durationString}</td></tr>
                      </table>
                      <p><a href="${env.BUILD_URL}">Open deployment details</a></p>
                    </div>
                """,
            to: 'prakashgautam2312@gmail.com',
            mimeType: 'text/html'
            }
        }
        failure {
            script {
                emailext attachLog: true,
                from: 'prakashgautam2312@gmail.com',
                subject: "❌ Deployment failed: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: """
                    <div style="font-family:Arial,sans-serif;max-width:640px;color:#243047">
                      <h2 style="color:#b42318">Deployment failed</h2>
                      <p>The Kubernetes manifest update or Git push failed. The console log is attached for investigation.</p>
                      <p><b>Project:</b> ${env.JOB_NAME}<br>
                         <b>Build:</b> #${env.BUILD_NUMBER}<br>
                         <b>Image tag:</b> <code>${env.IMAGE_TAG ?: 'not generated'}</code><br>
                         <b>Duration:</b> ${currentBuild.durationString}</p>
                      <p><a href="${env.BUILD_URL}console">Open console log</a></p>
                    </div>
                """,
            to: 'prakashgautam2312@gmail.com',
            mimeType: 'text/html'
            }
        }
    }
}
